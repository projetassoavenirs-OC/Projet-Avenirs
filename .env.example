# Copier ce fichier en .env.local pour le développement local (jamais versionné).
# En production, renseigner ces variables dans Vercel > Settings > Environment Variables.

# Jeton personnel Airtable (https://airtable.com/create/tokens)
# Scopes : data.records:read, data.records:write — Accès : base « Avenirs Application » uniquement
AIRTABLE_TOKEN=

# Identifiant de la base (commence par "app")
AIRTABLE_BASE_ID=appea8c2vWQ77ud45

# Compte parent
PARENT_USERNAME=Yannick
# Empreinte du mot de passe (jamais le mot de passe en clair) : npm run hash-password -- "MotDePasse"
PARENT_PASSWORD_HASH=

# Clé de signature des sessions (64 caractères hex aléatoires) : générée par npm run hash-password
SESSION_SECRET=
